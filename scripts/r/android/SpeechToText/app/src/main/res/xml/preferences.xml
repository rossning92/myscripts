<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="Provider">
        <EditTextPreference
            android:key="openai_api_key"
            android:title="OpenAI API Key"
            android:dialogTitle="OpenAI API Key"
            android:singleLine="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Input Methods">
        <SwitchPreferenceCompat
            android:key="accessibility_status"
            android:title="Accessibility Service"
            android:summary="Type dictated text into focused fields"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="ime_status"
            android:title="Silent Keyboard"
            android:summary="Type into apps like AVNC that only accept keyboard input"
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
