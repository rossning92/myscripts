type OVERLAY

# Right Shift (Linux scancode 54 = KEY_RIGHTSHIFT) -> Escape.
# This is a true remap at the input-mapping layer: apps only ever see ESCAPE,
# so the Shift modifier semantics are gone entirely. Works in every app without
# root or a running service, once the layout is selected in physical-keyboard
# settings.
map key 54 ESCAPE

# USB / Bluetooth HID keyboards report by HID usage rather than Linux scancode.
# If the line above has no effect, find the code with `adb shell getevent -l`
# while pressing Right Shift, then use the usage form instead, e.g.:
# map key usage 0x700000e5 ESCAPE

# Right Alt (Linux scancode 100 = KEY_RIGHTALT) -> Left Alt.
# Apps only ever see ALT_LEFT, so a right-Alt press behaves identically to left Alt
# (no AltGr semantics remain).
map key 100 ALT_LEFT

# HID usage fallback for USB / Bluetooth keyboards, e.g.:
# map key usage 0x700000e6 ALT_LEFT
