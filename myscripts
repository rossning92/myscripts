#!/bin/bash
set -e
SCRIPT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${TERMUX_VERSION}" ]]; then
    command -v python >/dev/null || pkg install -y python
    command -v tmux >/dev/null || pkg install -y tmux
elif [[ "$(uname)" == "Linux" ]]; then
    # Check if Debian-based distro
    if [[ -f "/etc/debian_version" ]]; then
        # Install required packages
        declare -a packages=(
            "python3"
            "python3-pip"
        )
        for package in "${packages[@]}"; do
            dpkg -s "$package" >/dev/null 2>&1 || {
                sudo apt-get update
                sudo apt-get install -y "$package"
            }
        done

    # Check if Arch-based distro
    elif [[ -f "/etc/arch-release" ]]; then
        function check_and_install {
            if ! pacman -Qi $1 >/dev/null; then
                echo "Package $1 is not installed."
                echo "Installing $1..."
                sudo pacman -S --noconfirm $1
            fi
        }
        check_and_install 'python'
    fi
fi

append_line_dedup() {
    touch "$1"
    # Remove the line if it exists and then append it
    if [[ -f "$1" ]] && grep -qF -- "$2" "$1"; then
        repl=$(printf '%s\n' "$2" | sed -e 's/[]\/$*.^[]/\\&/g')
        # If on mac, use sed -i '' instead of sed -i
        if [[ "$(uname)" == "Darwin" ]]; then
            sed -i '' "\%^$repl$%d" "$1"
        else
            sed -i "\%^$repl$%d" "$1"
        fi
    fi
    echo "$2" >>"$1"
}

# XXX: For some reason, mingw64 `bash.exe` may hang indefinitely while starting if it sources `$SCRIPT_ROOT/settings/bash/.bashrc`.
if [[ "$MSYSTEM" != MINGW64 ]]; then
    append_line_dedup \
        "$HOME/.bashrc" \
        "source \"$SCRIPT_ROOT/settings/bash/.bashrc\""
fi

# Set terminal title
echo -ne '\033]0;myscriptsmgr\007'

# Default settings for FZF
export FZF_DEFAULT_OPTS='--layout=reverse'

[[ ! -d "$HOME/.venv/myscripts" ]] && python3 -m venv "$HOME/.venv/myscripts" --system-site-packages
source "$HOME/.venv/myscripts/bin/activate"

pip install -r "$SCRIPT_ROOT/requirements.txt" >/dev/null
python "$SCRIPT_ROOT/myscripts.py" "$@"
